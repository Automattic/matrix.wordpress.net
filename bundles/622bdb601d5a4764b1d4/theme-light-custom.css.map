.mx_TextualBody_urlPreviews {
    /* Let shared-components own preview link colours instead of the app-wide anchor colour. */
    a:where(:not([data-kind])):hover,
    a:where(:not([data-kind])):link,
    a:where(:not([data-kind])):visited {
        color: revert-layer;
    }
}
